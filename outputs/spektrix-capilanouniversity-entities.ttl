<http://www.spektrix.com/capilanouniversity/event/22801AGSKTJDCRVHCKQCVVHGLQCVGCCGM>
  a schema:Event;
  schema:name "Pure Imagination Jr.";
  schema:description """
	Join us for an inspiring evening as the talented young performers of <span class=\"BoldText\">Khial Art Foundation</span> and <span class=\"BoldText\">Cadenza Music & Performing Arts Academy</span> take the stage in <span class=\"ItalicText\"><span class=\"BoldText\">Pure Imagination</span></span>, the exciting finale of our three-week Summer Musical Theatre Intensive for performers ages 8–14.<span><br/></span><span><br/></span>Licensed by Music Theatre International (MTI), Pure Imagination is a vibrant musical revue featuring unforgettable songs from Broadway Junior® favorites, including <span class=\"ItalicText\">Frozen, Beauty and the Beast, Shrek The Musical, Seussical,</span> and more. Created especially for young performers, each production is uniquely personalized, making every performance a one-of-a-kind celebration of creativity and imagination.<span><br/></span><span><br/></span>After three weeks of intensive training in singing, acting, and dance, these young artists are ready to share the confidence, passion, and teamwork they've developed throughout the program. Filled with memorable music, energetic choreography, and heartwarming performances, <span class=\"ItalicText\">Pure Imagination</span> is a joyful celebration of the next generation of musical theatre talent.<span><br/></span><span><br/></span><span><br/></span><a target=\"_blank\" href=\"https://www.cadenzacademy.ca/group-classes/summer-musical-theatre-intensive-august-2026\">More Info</a><span><br/></span><span><br/></span><h2>COMMUNITY RENTAL EVENT</h2><span><br/></span>All attendees need a ticket. Please contact us if you are bringing a \"babe in arms\"<span><br/></span><span><br/></span>
""";
  schema:startDate "2026-08-22T18:30:00"^^xsd:dateTime;
