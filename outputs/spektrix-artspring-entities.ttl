<http://www.spektrix.com/artspring/event/38401ANGTJSBMBHBQLHQPNRBLQSPPBRDN> a schema:Event;
  schema:name "Samson et Dalila (Saint-Saens) (Met Opera)";
  schema:description """
	Sacred, scandalous, and irresistibly alluring, Saint-Saëns’s spectacular take on the biblical hero of legendary strength and the seductive Philistine whose beauty overpowers him returns in the Met’s larger-than-life production. Featuring a massive orchestra and chorus and some of opera’s most spellbinding tunes, this masterpiece of French grand opera is a feast for the eyes and ears. Giacomo Sagripanti conducts an electrifying cast led by the formidable star pairing of mezzo-soprano Aigul Akhmetshina and tenor Clay Hilley. <span><br/></span><span><br/></span>This live cinema transmission is part of The Met: Live in HD series, bringing opera to movie theaters across the globe. Here at ArtSpring, enjoy our surround sound and famous quiche brunch during the intermission.<span><br/></span><span><br/></span>Performed in French with English subtitles <span><br/></span>
""";
  schema:startDate "2026-12-05T10:00:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/artspring/files/75b0c923-f12c-4e24-a1c4-37fa81305473.jpg>;
  schema:location <https://spektrix.com/artspring/location/403ASKCQMVCSKPPLNQMQPJVVSRPGMSKLR>;
  schema:offers _:6cfb468278f340539e63131aadaca0c98346;
  schema:duration "PT235M";
  schema:endDate "2026-12-05T13:55:00"^^xsd:dateTime .

