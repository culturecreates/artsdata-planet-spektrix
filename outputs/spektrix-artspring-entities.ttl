<http://www.spektrix.com/artspring/event/40001ASPQDPHTMRMGGVKLMLRBPQNHNVSD> a schema:Event;
  schema:name "WATER WORDS (AP)";
  schema:description """
	While some performances are aimed squarely at younger audiences, this colourful, flowing and thought-provoking experience engages children and adults alike, as it invites us all to reflect on how water shapes our lives, communities, and identities. Developed over three years in Burkina Faso, Senegal and Canada, it seamlessly blends spoken word, puppetry and object theatre<span><br/></span>with live music from Burkinabe multi-instrumentalist Dramane Dembélé. Exploring both the scarcity and abundance of water and how it shapes lives in both Western Africa and Canada, this beautifully crafted story lingers in the imagination, offering fresh perspectives on that which sustains us all. Directed and written by Hélène Ducharme and Mawby Mawine.<span><br/></span>Ideal for audiences six years and older | Approx 55 minutes.<span><br/></span><span><br/></span><span class=\"ItalicText\">Thank you to Mouat’s Home Hardware for sponsoring this performance.</span><span><br/></span>
""";
  schema:startDate "2026-10-29T19:00:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/artspring/files/b6a9ba92-380b-42c9-b79b-c0b65015439b.jpg>;
  schema:location <https://spektrix.com/artspring/location/403ASKCQMVCSKPPLNQMQPJVVSRPGMSKLR>;
  schema:offers _:6cfb468278f340539e63131aadaca0c98439;
