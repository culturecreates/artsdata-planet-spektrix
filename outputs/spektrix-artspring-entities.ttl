<http://www.spektrix.com/artspring/event/36401AGDPLVGNCJMRKTPQLBSBLCVKVSMG> a schema:Event;
  schema:name "The Scrotum Dialogues: The Geezers";
  schema:description """
	Sid Filkow and Patrick Cassidy take you on a laugh-out-loud visit to the netherlands and its two co-dependent, claustrophobic inhabitants as they struggle to make sense of the blurred, chaotic world outside and cope with the outrageous and impulsive behavior of the neighbour next door.<span><br/></span>All you ever wanted to know about what goes on in that testosterone-induced region south of the border (and some things you never wanted to know.) Don't get left holding the bag - get your tickets early!
""";
  schema:startDate "2026-10-02T19:30:00"^^xsd:dateTime;
