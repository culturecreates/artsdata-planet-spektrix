<http://www.spektrix.com/artspring/event/39401AHHBKTRJHJPLGBDBSTVVRJPBTKLC> a schema:Event;
  schema:name "BANFF CENTRE MOUNTAIN FILM FESTIVAL (AP)";
  schema:description """
	Since 1979, Banff Centre Mountain Film and Book festival has been one of the largest, most prestigious mountain festivals in the world. Hot on the heels of the Festival, held every fall, the Banff Centre Mountain Film Festival World Tour hits the road. With stops in more than 40 countries, the Banff World Tour celebrates achievements in outdoor storytelling and film-making worldwide.<span><br/></span><span><br/></span>You can be a part of the adventure here at ArtSpring, where we offer a carefully curated package of top films from this year’s festival, including award winners and audience favourites. A wonderful family experience.<span><br/></span>
""";
  schema:startDate "2026-10-08T19:00:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/artspring/files/33db3b7e-0e38-43d5-937c-b27a29255d5b.jpg>;
  schema:location <https://spektrix.com/artspring/location/403ASKCQMVCSKPPLNQMQPJVVSRPGMSKLR>;
