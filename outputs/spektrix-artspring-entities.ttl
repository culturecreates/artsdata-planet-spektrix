<http://www.spektrix.com/artspring/event/34601ALVSBJCTDPKVRHHHNJPRRSBQSGSH> a schema:Event;
  schema:name "GISS Dance presents... A Community Dance Performance";
  schema:description """
	GISS Dance program presents A Community Dance Performance! <span><br/></span><span><br/></span>We've invited our dance friends to climb up onto the stage with us! The show will include dance pieces from Jen Soo's Salt Spring Island Ballet competitive dance program, and will include soloists from her Studio North Dance Academy in Campbell River. Also included will be Sonia Langer's Children's Dance program presenting Ballet, Jazz and Tap dance pieces with kids ages 6 to 10. GISS Dance alumni who are currently studying Dance at Simon Fraser University will also join us! The roster will include our favourite GISS dance pieces, and a piece from the GISPA dancers as well. The show will offer a variety of dance styles, emotional qualities and music styles. Please come to support Dance on Salt Spring; help us remember that Dance is alive and well and thriving in our community!
""";
  schema:startDate "2026-06-05T19:00:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/artspring/files/996e674e-6a6e-4648-87b5-aeb6f3f9e2b4.jpg>;
  schema:location <https://spektrix.com/artspring/location/403ASKCQMVCSKPPLNQMQPJVVSRPGMSKLR>;
