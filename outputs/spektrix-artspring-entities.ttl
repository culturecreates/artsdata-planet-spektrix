<http://www.spektrix.com/artspring/event/41601AVNPVJKVCKMRJHHMRKVNNMTGJHSV> a schema:Event;
  schema:name "HISTORY OF MOTOWN (AP)";
  schema:description """
	Get schooled on soul! Krystle Dos Santos is not just an award-winning, powerhouse vocalist, songwriter, and performer who has shared stages with artists like Allen Stone, Serena Ryder, Ruth B, Stevie Wonder, and Michael Bublé. Dos Santos is also a musical historian—using her art to illuminate the cultural and historical impact of music. Explore the stories behind the songs, the artists who broke barriers, and the sound that defined a generation—intertwined with a high energy production, an extraordinary six piece band and unforgettable performances which celebrate the timeless groove of Stevie Wonder, Diana Ross, Marvin Gaye, The Supremes, The Jackson 5, and more. Yes, there will be dancing.
""";
  schema:startDate "2027-02-07T19:30:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/artspring/files/64da9009-f4b0-40ff-9ead-6fab644bb9e8.jpg>;
  schema:location <https://spektrix.com/artspring/location/403ASKCQMVCSKPPLNQMQPJVVSRPGMSKLR>;
  schema:offers _:6cfb468278f340539e63131aadaca0c98293;
  schema:duration "PT100M";
  schema:endDate "2027-02-07T21:10:00"^^xsd:dateTime .

