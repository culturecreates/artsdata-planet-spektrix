<http://www.spektrix.com/artspring/event/42601AHHMJKDLCSMPCMNQQTLCLBJSNVCP> a schema:Event;
  schema:name "STUART LITTLE (AP)";
  schema:description """
	A carousel theatre for young people production.<span><br/></span><span><br/></span>Celebrating 75 years since the book’s first publication, Joseph Robinette’s enchanting play brings this timeless tale to life in an intimate and captivating telling. As Stuart—the endearing little mouse with a great big heart—navigates a world built for humans, the play unfolds with a delightful mix of humour, adventure, and poignant moments. Beloved by generations of readers, E.B. White’s classic story comes to life in a delightful theatrical adaptation from Carousel Theatre. The production captures the charm of the original story while creating an engaging live experience for audiences of all ages. Young audiences will be captivated by the story’s playful spirit, while adults will appreciate its enduring themes of courage, belonging, and perseverance. This is family theatre at its most imaginative, uplifting, and entertaining.<span><br/></span><span><br/></span><span class=\"ItalicText\"><span class=\"BoldText\">Ideal for audiences aged four years and above | Approx 60 minutes (no intermission).</span></span><span><br/></span><span><br/></span><span class=\"ItalicText\">Thank you to Mouat’s Old Salty for sponsoring this performance.</span><span><br/></span>
""";
  schema:startDate "2027-03-16T18:30:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/artspring/files/e414e0bc-74bb-4b9b-887c-3d7bc44ef910.jpg>;
  schema:location <https://spektrix.com/artspring/location/403ASKCQMVCSKPPLNQMQPJVVSRPGMSKLR>;
  schema:offers _:6cfb468278f340539e63131aadaca0c98395;
  schema:duration "PT60M";
  schema:endDate "2027-03-16T19:30:00"^^xsd:dateTime .

