<http://www.spektrix.com/artspring/event/41201ATDVHVNDPRBLKPLQHLVPNSCNQLLP> a schema:Event;
  schema:name "VICTORIA BAROQUE PRESENTS: CANADIAN BAROQUE (AP)";
  schema:description """
	The ever-popular Victoria Baroque returns with two dynamic special guests and champions of traditional Canadian music: soprano Suzie LeBlanc, and baroque violinist and fiddler, David Greenberg. The program explores the power of song in Acadian and Cape Breton traditions and the European Baroque music that influenced them.<span><br/></span><span><br/></span>Victoria Baroque is an ensemble dedicated to bringing centuries-old masterpieces vividly to life, and approaches every performance with artistry, passion, and precision. Performing on period instruments and drawing on historical performance practices, the musicians reveal the vitality, drama, and emotional depth at the heart of this remarkable repertoire. Baroque music remains vibrant, expressive, and surprisingly contemporary in its ability to move and inspire audiences. The result is a rich, timeless concert experience.<span><br/></span><span><br/></span><span class=\"ItalicText\">Thank you to Elly Silverman for sponsoring this performance in honour of her sister Sylvie.</span><span><br/></span>
""";
  schema:startDate "2027-01-16T14:30:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/artspring/files/38a817b1-b4a3-4668-b61c-d3dbad1d88c2.jpg>;
  schema:location <https://spektrix.com/artspring/location/403ASKCQMVCSKPPLNQMQPJVVSRPGMSKLR>;
