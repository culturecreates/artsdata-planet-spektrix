<http://www.spektrix.com/artspring/event/41401ASSQNDLHNVKJRVQSRBSHHNBDDDQS> a schema:Event;
  schema:name "I DON’T BELONG HERE (AP)";
  schema:description """
	A tale of dementia that rejects bleakness—instead expect a compassionate and nuanced perspective that embraces empathy, humour, joy, and humanity. Told from the perspective of those living with dementia, those who love them, and those who care for<span><br/></span>them, there is a mix of absurdity and poignancy, grief and laughter, and ultimately an affirmation of the power of connection, even at the edge of forgetting.<span><br/></span><span><br/></span>Written and performed by Joëlle Rabu, Kelly Wyatt and Nico Rhodes, and directed by Kymme Patrick, this musical interpretation invites you to witness a day at a dementia care residence, as seen through the eyes of all those affected by the loss of memory, love and self. With mature content and themes, this show is suitable for older audiences.<span><br/></span><span><br/></span><span class=\"ItalicText\">Thank you to Kate Merry and Victoria Olchowecki for sponsoring this performance.</span><span><br/></span>
""";
  schema:startDate "2027-01-24T14:30:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/artspring/files/b78bcf5b-c5de-4a81-86e9-7f15e7dd26cc.jpg>;
  schema:location <https://spektrix.com/artspring/location/403ASKCQMVCSKPPLNQMQPJVVSRPGMSKLR>;
  schema:offers _:6cfb468278f340539e63131aadaca0c98294;
  schema:duration "PT100M";
  schema:endDate "2027-01-24T16:10:00"^^xsd:dateTime .

