<http://www.spektrix.com/artspring/event/26201AGBHCTNMDGTRMRCVQPKJNVHQTBBK> a schema:Event;
  schema:name "Expect Delays";
  schema:description """
	THE GEEZERS <span class=\"ItalicText\">EXPECT DELAYS</span> - Back by popular demand<span><br/></span><span><br/></span>Buckle up and take an uproarious ride with the Geezers, Sid Filkow and Patrick Cassidy as the reprise their October show and navigate the blind curves and pot-holes of Island life, and life in general. <span><br/></span><span><br/></span>The October performances were sold out so get your tickets pronto. Already seen it, you say? Well, as Arvid would say, <span class=\"ItalicText\">A Geezer show is never the same once</span><span><br/></span><span><br/></span>Audience Said: <span class=\"ItalicText\">Salt Spring Magic</span>, <span class=\"ItalicText\">My face hurt from laughing</span>, <span class=\"ItalicText\">Classic Geezers</span><span><br/></span><span><br/></span>Adults $30.00CAD $60.00USD Including Tariff 
""";
  schema:startDate "2026-03-29T14:00:00"^^xsd:dateTime;
