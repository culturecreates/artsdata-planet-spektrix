<http://www.spektrix.com/nationalmusiccentre/event/182201AKLHSBJGPRBLJBLDPLKPHGJSQQC>
  a schema:Event;
  schema:name "A Holly Jolly Jill Barber Christmas";
  schema:description """
	Join Jill Barber and her jingly jangly jazz quartet as they take you on a nostalgic musical sleigh ride through decades of beloved Christmas standards. You'll enjoy hot cocoa classics like \"I'll be Home for Christmas\" and \"Rudolph the Red-Nosed Reindeer,\" seasonal favourites like \"You're a Mean One, Mr. Grinch,\" and heartfelt originals composed by Barber herself. Expect laughter and tears, and a cup of good cheer, as Jill shares her best Christmas stories and favourite festive songs. A contemporary cross between Judy Garland and Bing Crosby, a Holly Jolly Jill Barber Christmas is the perfect gift for family and friends, both young and old! <span><br/></span><span><br/></span><a target=\"_blank\" href=\"https://www.google.com/maps/place/Studio+Bell,+home+of+the+National+Music+Centre/@51.0445506,-114.054786,17z/data=!3m1!4b1!4m5!3m4!1s0x53717aaa864fd43b:0x7609799479e4d20e!8m2!3d51.0445591!4d-114.0529828\">Studio Bell, 850 4 Street SE Calgary</a><span><br/></span><span><br/></span>Doors: 6:30 pm. Show: 7:30 pm.<span><br/></span><span><br/></span>General Admission: $59.00 + GST<span><br/></span><span><br/></span>Members receive 15% off — just log into your NMC account and it’s applied automatically.<span><br/></span>
""";
  schema:startDate "2026-12-13T19:30:00"^^xsd:dateTime;
