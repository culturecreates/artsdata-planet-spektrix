  a schema:Event;
  schema:name "Liner Notes: Inside the Rolling Stones Mobile Studio — 'Led Zeppelin III'";
  schema:description """
	<span class=\"BoldText\">Liner Notes: Inside the Rolling Stones Mobile Studio</span> is part storytelling tour, part listening session, exploring the legendary albums recorded in the \"Sistine Chapel of rock 'n' roll.\" Step back in time and experience <span class=\"ItalicText\">Led Zeppelin III</span> as it was recorded through the RSM.<span><br/></span><span><br/></span><a target=\"_blank\" href=\"http://maps.app.goo.gl/8qsAVPVjfZLiTRn96\">King Eddy, 438 9 Ave SE Calgary</a><span><br/></span><span><br/></span>Tour starts at 2:00 pm. Please meet inside the King Eddy.<span><br/></span><span><br/></span>Tickets: $45 + GST<span><br/></span><span><br/></span>NMC Members get 15% off. Log in with the email associated with your membership to automatically receive your discount.
""";
