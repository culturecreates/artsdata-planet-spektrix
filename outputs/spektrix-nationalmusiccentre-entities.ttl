<http://www.spektrix.com/nationalmusiccentre/event/175601ADPRDBVBBRDVRPSCGSJCDLNSRQJ>
  a schema:Event;
  schema:name "Kaminéh & NMC Present: Head In The Clouds";
  schema:description """
	Head in the Clouds is a curated underground DJ night hosted on the Studio Bell Skybridge — suspended above Calgary's skyline. Presented by Kaminéh and the National Music Centre, the night brings together an exclusive gathering of music lovers for an evening of live DJ sets rooted in South Asian sound with live instrumentation, featuring Asad Khan, Raaginder, Bobby Kang, and Kokaheena.<span><br/></span><span><br/></span><a target=\"_blank\" href=\"https://www.google.com/maps/place/Studio+Bell,+home+of+the+National+Music+Centre/@51.0445506,-114.054786,17z/data=!3m1!4b1!4m5!3m4!1s0x53717aaa864fd43b:0x7609799479e4d20e!8m2!3d51.0445591!4d-114.0529828\">Studio Bell, 850 4 Street SE Calgary</a><span><br/></span><span><br/></span>Doors: 9:30 pm. Show: 10 pm to 2 am.<span><br/></span><span><br/></span>Early-bird: $35 + GST
""";
  schema:startDate "2026-05-23T22:00:00"^^xsd:dateTime;
