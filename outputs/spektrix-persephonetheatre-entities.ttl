<http://www.spektrix.com/persephonetheatre/event/3873ABMLGTQJDDKPQHRCBHTRVKPBNLSTL>
  a schema:Event;
  schema:name "Blithe Spirit";
  schema:description """
	by Noël Coward<span><br/></span>Recommended Audience: 12 plus<span><br/></span>Running Time 2 hours and 35 minutes, plus intermission<span><br/></span><span><br/></span>In this uproarious comedy by the master of wit, socialite and novelist Charles has invited the eccentric medium, Madame Arcati, to his house as research for his next book. But when their dinner-party-turned-séance proves successful, Charles’ marriage is suddenly in jeopardy as he is haunted by the ghost of his first wife. While Charles schemes to get rid of the ghost, she is hard at work trying to get rid of his new wife! One husband and two feuding wives unveils a whole lot of laughs in this mystical comedy of manners!
""";
  schema:startDate "2026-04-29T19:30:00"^^xsd:dateTime;
