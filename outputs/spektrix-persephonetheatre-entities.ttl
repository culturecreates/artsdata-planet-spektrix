<http://www.spektrix.com/persephonetheatre/event/64601AHJJJGRPPGBJRDJBKDBVLLBQMRLP>
  a schema:Event;
  schema:name "WINTER 27 | Discovery Kids: PLAYground | Session 3 | Ages 4 & 5";
  schema:description """
	JANUARY 16th to FEBRUARY 27th 2027<span><br/></span>Saturdays | 12:15 PM to 1:15 PM<span><br/></span><span><br/></span>Join us for this interactive creative blast of fun! Stories, music and play characters are all part of this confidence and communication building program. Over a six week period children will explore a new theme each week making each class a brand new adventure!<span><br/></span><span><br/></span>Students should wear comfy clothing they can easily move in, have indoor shoes, and can bring a water bottle.<span><br/></span><span><br/></span>SESSION THREE THEMES <span><br/></span>January 16    Winter Wonderland <span><br/></span>January 23   Cuddly Kitty and Puppy Dog Tales <span><br/></span>January 30   Pirate Playtime<span><br/></span>February 6    Sensational Senses<span><br/></span>February 20  Farmyard Fun <span><br/></span>February 27   Celebration Countdown <span><br/></span><span><br/></span>If you have any program questions please reach out to Director of Education Lorna Batycki lorna.b@persephonetheatre.org
""";
  schema:startDate "2027-01-16T12:15:00"^^xsd:dateTime;
