<http://www.spektrix.com/persephonetheatre/event/3730ACDDPTQHGBBJVHDRBHKNCPMVQKJVT>
  a schema:Event;
  schema:name "Disney's Dare to Dream Jr. - Persephone Theatre School";
  schema:description """
	<span class=\"ItalicText\">Disney’s Dare to Dream Jr.</span> celebrates 100 years of beloved musical magic as a young group of “imagineers” embark on a journey to celebrate dreams that unite, inspire, and make anything possible. The show features songs appearing for the first time ever in a Disney stage musical as well as classic fan favourites from <span class=\"ItalicText\">The Princess and The Frog, Encanto, Frozen, Tangled, Aladdin</span> and more! 
""";
