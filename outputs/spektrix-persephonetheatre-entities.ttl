  schema:offers _:a9a424fcb3ab475ea2103afc11b5c6ad152;
  schema:duration "PT60M";
  schema:endDate "2027-03-06T14:00:00"^^xsd:dateTime .

_:a9a424fcb3ab475ea2103afc11b5c6ad152 a schema:AggregateOffer;
  schema:lowPrice "16.65";
  schema:priceCurrency "CAD" .

