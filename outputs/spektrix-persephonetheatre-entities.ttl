<http://www.spektrix.com/persephonetheatre/event/3496AVBQDBJKRPCRCPKJNJVJSKHMNRGQC>
  a schema:Event;
  schema:name "The Romeo Initiative";
  schema:description """
	by Trina Davies<span><br/></span><span><br/></span>Recommended Audience: 12 plus<span><br/></span>Running time: 2 hours, including intermission<span><br/></span><span><br/></span>The perfect man. The perfect romance.<span><br/></span><span><br/></span>Single men are hard to come by in Cold War Germany so when Karin Maynard meets the handsome and attentive Markus Richter while on vacation abroad, it has to be fate. Or is it?<span><br/></span><span><br/></span>Based on a real program in East Germany in which men were trained by the Stasi to be the “perfect man” to woo West German secretaries, <span class=\"ItalicText\">The Romeo Initiative</span> is half romantic comedy and half spy thriller with a tantalizing twist.
""";
  schema:startDate "2026-02-04T19:30:00"^^xsd:dateTime;
