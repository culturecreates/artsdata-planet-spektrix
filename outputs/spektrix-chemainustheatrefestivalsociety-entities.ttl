<http://www.spektrix.com/chemainustheatrefestivalsociety/event/31801ADDBNQLLLKJTNRHHPMNDDRKHTBJB>
  a schema:Event;
  schema:name "Zachary Stevenson - Dinner & Entertainment Cabaret";
  schema:description """
	SEPT 9-13<span><br/></span><span><br/></span>Cabaret - Dinner and Live Entertainment<span><br/></span><span><br/></span>Zach is back in Chemainus for an intimate solo concert in the Playbill Dining Room. You'll  remember the popular, island-raised artist for his acclaimed performances in the Buddy Holly Story, Ring of Fire and the world premiere of Dead Ringer. An engaging showman, Zachary will entertain with a variety of legendary favorites and original offerings for a memorable evening of music.<span><br/></span><span><br/></span>Tickets: $93 (inc. tax)<span><br/></span><span><br/></span>Includes Salad Bar, 3-course Plated Dinner, Dessert Bar, Coffee/Tea/Soda and an intimate live performance in the Playbill Dining Room (approx 1 hr).<span><br/></span><span><br/></span><h2><a target=\"_blank\" href=\"https://chemainustheatrefestival.ca/wp-content/uploads/2026/07/Zachary-Stevenson-Cabaret-Menu-2026.pdf\"> View the Menu</a> </h2>
""";
