  a schema:Event;
  schema:name "Sugar Road";
  schema:description """
	Feb 19 - Mar 21 <span><br/></span><span><br/></span><span class=\"ItalicText\"><span class=\"BoldText\">Available to Priority Access Patrons with a 2027 Subscription</span></span><span><br/></span><span><br/></span>By: Kristen Da Silva<span><br/></span><span><br/></span>Twelve years after a single magical evening under the stars, a top country singer and a small-town woman meet again. Kristin Da Silva’s Sugar Road is a dreamy romantic comedy full of laughter, small-town memories, original country music, and second-chance sparks.<span><br/></span><span><br/></span>Recommended Age: 14+<span><br/></span><span><br/></span><span class=\"BoldText\">2027 Season On Sale Dates:</span><span><br/></span><span><br/></span><ul><li><span class=\"BoldText\">Nov 3</span> – <span class=\"ItalicText\">Priority Access for Super Patrons</span>  </li><li><span class=\"BoldText\">Nov 12</span> – <span class=\"ItalicText\">Priority Access for Subscription Renewals</span>  </li><li><span class=\"BoldText\">Dec 1</span> – Subscriptions on sale to the general public </li><li><span class=\"BoldText\">Jan 5</span> - Single Tickets on sale</li></ul><span><br/></span><span class=\"ItalicText\"><span class=\"BoldText\">Note:</span> Performance dates for the 2027 season may only be booked by eligible patrons purchasing 2027 subscriptions during the Priority Access and subscription sales periods outlined above.</span>
""";
