<http://www.spektrix.com/rcmusic/event/476001APSDBVNKMJGPSRBPQGDVDRSCRLK> a schema:Event;
  schema:name "Post-Concert VIP Reception";
  schema:description """
	<h2>Raising the Baton: Post-Concert VIP Reception</h2><span><br/></span>Following Canada's first-ever showcase of female conductors, continue the celebration with an exclusive Post-Concert Reception. Join host Ann-Marie MacDonald, WML founders Michael Hidetoshi Mori & Jaime Martino\\, and the artists of Raising the Baton in the elegant glassed atrium of Koerner Hall overlooking Toronto.<span><br/></span><span><br/></span>Raise a glass to these incredibly talented conductors, celebrating their remarkable achievements and the inspiring impact of the Women in Musical Leadership (WML) program. This intimate gathering offers a unique opportunity to connect with the trailblazing women changing the face and landscape of classical music in North America.
<span><br/></span><span><br/></span>By joining us for this reception, you are directly supporting an expanding legacy for Canadian classical music. All funds raised ensure that emerging conductors continue to receive vital professional opportunities to jump-start their careers nationally and internationally.
<span><br/></span>
""";
  schema:startDate "2027-02-09T21:00:00"^^xsd:dateTime;
  schema:location <https://spektrix.com/rcmusic/location/1AHGJDSMMPLMPPGNLJBQVLBRSKVDLQRPP>;
  schema:organizer <https://spektrix.com/rcmusic/organization/tapestry-opera>;
  schema:duration "PT60M";
  schema:endDate "2027-02-09T22:00:00"^^xsd:dateTime .

