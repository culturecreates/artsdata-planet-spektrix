    schema:Event;
  schema:name "Confabulation: Home for the Holidays";
  schema:description """
	Home for the Holidays will feature the music of Sarah Segal-Lazar and six storytellers will take it all home with stories about crowded rooms, curious customs, weary travelers, joy, fatigue, function and dysfunction, excitement and expectations.
""";
