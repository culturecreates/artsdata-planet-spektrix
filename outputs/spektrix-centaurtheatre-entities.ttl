<http://www.spektrix.com/centaurtheatre/event/95601AKBTMBPSVSQQNHNMNCNJRTLHSSTL> a
    schema:Event;
  schema:name "The Silent Woman";
  schema:description """
	Inspired by the Gothic novels of the Brontë sisters and the suspenseful atmospheres of Daphne du Maurier, <span class=\"ItalicText\">The Silent Woman</span> is a spine-tingling, puzzle-box of a play: a novel disguised as a play about writing a novel.<span><br/></span>/<span><br/></span>Inspirée des romans gothiques des sœurs Brontë et des atmosphères à suspense de Daphne du Maurier, <span class=\"ItalicText\">The Silent Woman</span> est une pièce à la fois intrigante et vertigineuse, construite comme un véritable jeu de piste : un roman déguisé en pièce de théâtre qui raconte l’écriture d’un roman.<span><br/></span>
""";
  schema:startDate "2027-02-10T20:00:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/centaurtheatre/files/ee1014c4-9582-442c-9885-5e23840068c4.jpg>;
