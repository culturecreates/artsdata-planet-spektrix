<http://www.spektrix.com/manitobaopera/event/23601ABQMTDMTTDQVVNJCNJPSQCSVMLHB> a
    schema:Event;
  schema:name "Film Screening: The Sting";
  schema:description """
	Film Screening: <span class=\"ItalicText\">The Sting</span> (1973)<span><br/></span>Friday, October 23<span><br/></span>Landmark Cinemas Grant Park<span><br/></span>1:00 PM (doors open 12:30 PM)<span><br/></span><span><br/></span>Winner of seven Academy Awards, this caper film starring Paul Newman and Robert Redford was also notable for its soundtrack, which heavily featured the music of Scott Joplin and contributed to a resurgence of interest in Joplin's work in that decade.<span><br/></span><span><br/></span>The film will be introduced by film enthusiast, journalist, and educator, Alison Gillmor, with a brief presentation about the music of Scott Joplin given by composer and conductor Larry Strachan.<span><br/></span><span><br/></span>This event is free to attend.<span><br/></span>Advance registration is required. Limited seating.
""";
  schema:startDate "2026-10-23T13:00:00"^^xsd:dateTime;
