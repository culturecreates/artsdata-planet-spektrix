<http://www.spektrix.com/manitobaopera/event/25001ADDVSKQBVSNBTBDPCMQTVGBHJDPN> a
    schema:Event;
  schema:name "An Ode to Black Opera";
  schema:description """
	 The program features arias, spirituals, and art songs by Black composers, alongside selections from landmark works such as George Gershwin’s Porgy and Bess and Broadway musicals Ragtime and The Wiz, which illuminate the Black American experience and its profound impact on the performing arts.<span><br/></span><span><br/></span>Free to attend. Advance registration is appreciated.<span><br/></span><span><br/></span>We acknowledge the support of the Canada Council for the Arts.
""";
