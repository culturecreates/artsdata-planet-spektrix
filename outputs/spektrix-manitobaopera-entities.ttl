<http://www.spektrix.com/manitobaopera/event/16401ABVRRCMPGBBKHVKSLVNQTBRMLVRH> a
    schema:Event;
  schema:name "Madama Butterfly";
  schema:description """
	<span class=\"BoldText\">A BELOVED STORY. UNFORGETTABLE MELODIES.</span><span><br/></span><span><br/></span><span class=\"BoldText\">The Story</span><span><br/></span>This haunting drama in the high hills of the Nagasaki harbour tells the story of Cio-Cio-San, a beautiful and innocent Japanese geisha who falls in love with Pinkerton, a dashing U.S. Navy lieutenant. Her love for Pinkerton transcends culture and family, and they marry. But some vows aren’t forever. Pinkerton soon leaves Japan and Butterfly unwaveringly waits three long years for his return. When his ship comes in her dreams for the future meet his – with tragic and heartbreaking results.<span><br/></span><span><br/></span><a target=\"_blank\" href=\"https://mbopera.ca/season/madama-butterfly/\">LEARN MORE</a>
""";
  schema:startDate "2027-04-17T19:30:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/manitobaopera/files/6e2b5384-68d9-4814-8121-11572e15fc9a.jpg>;
  schema:location <https://spektrix.com/manitobaopera/location/411APPGHLQHMBTKVQCCLNCNNTVTQRHRKG>;
  schema:organizer <https://spektrix.com/manitobaopera/organization/manitoba-opera>;
  schema:offers _:2007044f31bc4ffa873b8e9bb34881f64243;
  schema:duration "PT165M";
  schema:endDate "2027-04-17T22:15:00"^^xsd:dateTime .

