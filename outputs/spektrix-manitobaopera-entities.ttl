    schema:Event;
  schema:name "Friday Dinner";
  schema:description """
	<a target=\"_blank\" href=\"https://manitoba-opera.s3-assets.com/PDFs/2026-27_Treemonisha_Dinner-Friday.pdf\">Check out the Menu</a><span><br/></span><span class=\"ItalicText\">Vegetarian option available.</span><span><br/></span><span><br/></span><h2>About the Caterer:</h2><a target=\"_blank\" href=\"https://nyumbaniafricandelicacies.com/\">Nyumbani African Delicacies</a> was born in 2020 from a shared vision: to bridge the gap between authentic East African home cooking and high-standard Canadian catering. Lydia Kwamboka is the Heart of the Kitchen, with experience from Dubai to Canada and is on her way to Red Seal certification.
""";
