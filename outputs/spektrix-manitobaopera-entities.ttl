  schema:organizer <https://spektrix.com/manitobaopera/organization/manitoba-opera>;
  schema:offers _:8669c22bfe5949afb8f6b916737cab014843;
  schema:duration "PT170M";
  schema:endDate "2026-11-21T22:20:00"^^xsd:dateTime .

