  schema:organizer <https://spektrix.com/manitobaopera/organization/manitoba-opera>;
  schema:offers _:e7331e89a7a2400ca720e9295a95796e4188;
  schema:duration "PT150M";
  schema:endDate "2026-11-21T22:00:00"^^xsd:dateTime .

