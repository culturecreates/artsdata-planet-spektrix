<http://www.spektrix.com/sidwilliams/event/209001ATKSQPNGBHSVCHLDSQSJPPGNNNM> a schema:Event;
  schema:name "51st CVCDA Children's Telethon";
  schema:description """
	The Comox Valley Child Development Association (CVCDA) will host the 51st Annual CVCDA Children's Telethon this year, and they are inviting you to join the magic at the Sid Williams Theatre to help them celebrate the Comox Valley community and their dedicated supporters!<span><br/></span><span><br/></span>The Telethon is a <span class=\"BoldText\">FREE</span> event where the whole family can come down and experience a live Rogers TV broadcast, enjoy over 30 performances, raffles, special guests, kids' activities and simply just be part of the wonderful fundraising spirit of the Comox Valley.<span><br/></span><span><br/></span>Families will also have the opportunity to view from the comforts of their own home or wherever they are in real-time from their TVs or streaming devices.<span><br/></span><span><br/></span>Visit CVCDA.ca for more details and to stream the telethon on Sun. November 1st. <span><br/></span><span><br/></span>Visit https://www.cvcda.ca/telethon/telethon-donations/ to donate!
""";
  schema:startDate "2026-11-01T12:00:00"^^xsd:dateTime;
