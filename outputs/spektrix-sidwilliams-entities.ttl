<http://www.spektrix.com/sidwilliams/event/210601AKRDPBSJBJHTRMDRJKPKSBGBRDS> a schema:Event;
  schema:name "Coastal Arts Academy's Neverland";
  schema:description """
	<span class=\"BoldText\">SECOND STAR TO THE RIGHT AND STRAIGHT ON ’TIL MORNING!</span><span><br/></span> <span><br/></span><span class=\"BoldText\">Get ready to fly away to Neverland with Coastal Arts Academy!</span> <span><br/></span><span><br/></span>Join Coastal Arts Academy for their magical winter dance recital, <span class=\"BoldText\"><span class=\"ItalicText\">Neverland: Peter Pan</span></span>, where the talented Coastal Arts dancers will bring the beloved story of Peter Pan, Tinker Bell, Wendy, and the Lost Boys to life through dance. <span><br/></span><span><br/></span>From the magic of Pixie Hollow to the adventures of Neverland, this enchanting show will be filled with imagination, adventure, and plenty of dancing magic. <span><br/></span><span><br/></span>Coastal Arts Academy cannot wait to share all the hard work, creativity, and passion their dancers have put into this special performance. <span><br/></span><span><br/></span>All you need is faith, trust, and a little bit of pixie dust! <span><br/></span><span><br/></span><span class=\"BoldText\">Coastal Arts Academy — where dreams take flight.</span><span><br/></span>
""";
  schema:startDate "2026-11-21T17:00:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/sidwilliams/files/c67fc204-3ed9-4a28-985f-f4089eba42da.jpeg>;
  schema:location <https://spektrix.com/sidwilliams/location/201AGBHDRLQHNHPHKKMPKLGPMDRDTDMVL>;
  schema:organizer <https://spektrix.com/sidwilliams/organization/coastal-arts-academy>;
  schema:url <https://www.sidwilliamstheatre.com/events/coastal-arts-academys-neverland/>;
  schema:offers _:8669c22bfe5949afb8f6b916737cab011580;
  schema:keywords "Dance";
  schema:duration "PT60M";
  schema:endDate "2026-11-21T18:00:00"^^xsd:dateTime .

