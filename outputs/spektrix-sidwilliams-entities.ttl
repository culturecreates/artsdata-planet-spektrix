<http://www.spektrix.com/sidwilliams/event/210001ABSLVMJVHHPMCPGQQVCTSKKVCVH> a schema:Event;
  schema:name "Eagle Eyes \"Celebrating the Eagles & Joe Walsh\"";
  schema:description """
	The Eagles dominated soft rock throughout the 70’s with unforgettable hits like \"Take It Easy\", \"Witchy Woman\", \"Best Of My Love\", \"One of These Nights\", \"Lyin’ Eyes\", \"Take It To The Limit\", \"New Kid In Town\", \"Hotel California\", \"Life In The Fast Lane\", \"Heartache Tonight\", \"The Long Run\", \"I Can’t Tell You Why\"... and more. <span><br/></span><span><br/></span>Eagle Eyes capture lead and harmony vocals with breath-taking precision that is nothing less than stunning. <span><br/></span><span><br/></span>All vocals are live!
""";
  schema:startDate "2027-01-09T19:30:00"^^xsd:dateTime;
