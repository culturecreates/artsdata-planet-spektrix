<http://www.spektrix.com/sidwilliams/event/206001ADCDBKTCSPDMJTBKGKPPRDVCHPS> a schema:Event;
  schema:name "Casey and Diana";
  schema:description """
	<span class=\"BoldText\">CASEY and DIANA</span><span><br/></span>Directed by Brian Mather <span><br/></span><span><br/></span>Set in Toronto’s Casey House during the height of the 1991 AIDS crisis, Casey and Diana is a deeply moving, funny, and hopeful new play by Canadian playwright Nick Green. As residents and caregivers prepare for Princess Diana’s historic visit, they discover unexpected moments of courage, connection, and compassion.<span><br/></span><span><br/></span>Inspired by true events, this unforgettable drama celebrates the resilience of the human spirit and the power of kindness to challenge fear and transform lives. <span><br/></span><span><br/></span><span class=\"BoldText\">“Powerful, Gripping, Funny and Hopeful”</span> – Hamilton City Magazine 
""";
  schema:startDate "2027-04-21T19:30:00"^^xsd:dateTime;
