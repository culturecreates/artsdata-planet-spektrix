<http://www.spektrix.com/factorytheatre/event/145202AJRDJSQJTHVRDDNJGBNKRCDJDVM> a
    schema:Event;
  schema:name "Mujer Venado | Deer Woman";
  schema:description """
	<span class=\"ItalicText\"><span class=\"BoldText\">Lila is a warrior. She is the daughter of a hunter who taught her all he knew. She’s ex-army, too. When circumstances converge, Lila finds the perfect opportunity to avenge her baby sister’s murder while exercising the skills taught by the Canadian government.</span></span><span><br/></span><span><br/></span><span class=\"BoldText\">ARTICLE 11</span> and <span class=\"BoldText\">Aluna Theatre</span> bring to RUTAS the Canadian premiere of <span class=\"ItalicText\"><span class=\"BoldText\">Deer Woman</span></span> written by Nlaka’pamux playwright Tara Beagan, one of the most influential playwrights on Turtle Island. Performed in Spanish with English surtitles for the first time, <span class=\"ItalicText\"><span class=\"BoldText\">Mujer Venado</span></span> speaks to the national and international crisis of missing and murdered Indigenous women and girls in Canada and across the Americas.<span><br/></span><span><br/></span>Duration: approx. 80 minutes<span><br/></span>Age Recommendation: 16+<span><br/></span><span><br/></span><span class=\"BoldText\">Content Warnings:  Graphic descriptions of historical and contemporary hate crimes, childhood sexual abuse, and graphic depictions of other violence.</span><span><br/></span>
""";
  schema:startDate "2026-10-01T19:30:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/factorytheatre/files/09f34b6b-5969-4cb0-a0c2-a7b4544a517c.jpg>;
  schema:location <https://spektrix.com/factorytheatre/location/1AHGJDSMMPLMPPGNLJBQVLBRSKVDLQRPP>;
  schema:offers _:2007044f31bc4ffa873b8e9bb34881f6276;
  schema:duration "PT80M";
  schema:endDate "2026-10-01T20:50:00"^^xsd:dateTime .

_:2007044f31bc4ffa873b8e9bb34881f6276 a schema:AggregateOffer;
  schema:lowPrice "25.0";
  schema:priceCurrency "CAD" .

