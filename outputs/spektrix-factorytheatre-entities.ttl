<http://www.spektrix.com/factorytheatre/event/146002ABJNJKRSBJJHKTLSKHPNPLHMPPK> a
    schema:Event;
  schema:name "Documents Perform 3";
  schema:description """
	<span class=\"ItalicText\"><span class=\"BoldText\">The Setting: A blank stage with a giant screen. Projected onto the screen are two documents containing excerpts of the Massey Commission in English and French. An online ensemble of “hacktors” made up of artists, artistic producers, cultural leaders, and policymakers begin “hacking” and rewriting the Commission in unison, in real time before a live audience. </span></span><span><br/></span><span><br/></span><span class=\"ItalicText\"><span class=\"BoldText\">Documents Perform 3</span></span> asks a simple question: Who gets to define the value of culture, and how? The 1951 Royal Commission on National Development in the Arts, Letters and Sciences (better known as the Massey Commission) established a foundation for how Canada has understood arts, culture, and national identity for more than seventy years. What happens when those historically excluded from its vision become its editors and, in turn, the co-authors of a new cultural blueprint?<span><br/></span><span><br/></span>As edits unfold on screen, spectators will witness not simply the deconstruction of a historical document, but a public negotiation over the values that ought to guide Canada's cultural future. At the conclusion of the performance, the newly authored text will be read aloud and publicly ratified as the first iteration of an evolving cultural charter, one that will continue to be collectively rewritten, contested, and expanded over the seven-year life of The Arts Impact Partnership (TAIP) as new voices, communities, and understandings of cultural value emerge.<span><br/></span><span><br/></span>Performance Action | Projections in both Français and English<span><br/></span>Duration: 120 mins (approx.)<span><br/></span>Age Recommendation: 10+<span><br/></span>
""";
  schema:startDate "2026-09-27T14:30:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/factorytheatre/files/68ad5ceb-fab3-4916-b7b8-18478343ea26.jpg>;
  schema:location <https://spektrix.com/factorytheatre/location/1AHGJDSMMPLMPPGNLJBQVLBRSKVDLQRPP>;
  schema:offers _:2007044f31bc4ffa873b8e9bb34881f6272;
  schema:duration "PT120M";
  schema:endDate "2026-09-27T16:30:00"^^xsd:dateTime .

_:2007044f31bc4ffa873b8e9bb34881f6272 a schema:AggregateOffer;
  schema:lowPrice "25.0";
  schema:priceCurrency "CAD" .

<http://www.spektrix.com/factorytheatre/event/146202ASMJCHQGGQQQPGSLCSBBCHRPQJG> a
    schema:Event;
  schema:name "Laura Ramoso: The Calm Down Tour PREVIEWS with post-show Q&A";
  schema:description """
	Laura runs her show for a hometown crowd before she heads out on the North American leg of her <span class=\"ItalicText\"><span class=\"BoldText\">Calm Down Tour! w/ post-show live Q&A</span></span><span><br/></span><span><br/></span><a target=\"_blank\" href=\"https://www.instagram.com/lau_ramoso/\">Laura Ramoso</a> is a German-Italian comedian best known for her live sketch specials and viral impressions on social media. She has amassed over 3 million followers with hit characters like “German Mom,” “Italian Dad,” and “Chiara”. In 2023, she performed an entirely sold-out run at the Edinburgh Fringe Festival and London’s Soho Theatre with her critically-acclaimed second hour, <span class=\"ItalicText\">FRANCES</span>. Laura was named a 2023 Just for Laughs New Face of Comedy. In 2024, she embarked on her first international tour with her third special, <span class=\"ItalicText\">Sit Up Straight</span>, running 60+ sold-out shows throughout Australia, New Zealand, Europe, the UK, Canada, and the US. In 2025, she opened for Tina Fey and Amy Poehler on their Restless Leg tour at the Wang Theatre in Boston. She is currently on the road with her fourth entirely sold out hour, The Calm Down Tour.<span><br/></span><span><br/></span>Duration: approx. 105 mins (including post-show Q & A)<span><br/></span>Age recommendation: 14+<span><br/></span>Content Warnings: Flashing lights, loud noises, mature content.
""";
  schema:startDate "2026-09-01T19:30:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/factorytheatre/files/dd152ca0-f9ec-4a89-858b-a891b8c16018.jpg>;
  schema:location <https://spektrix.com/factorytheatre/location/1AHGJDSMMPLMPPGNLJBQVLBRSKVDLQRPP>;
  schema:offers _:2007044f31bc4ffa873b8e9bb34881f6273;
  schema:duration "PT105M";
  schema:endDate "2026-09-01T21:15:00"^^xsd:dateTime .

