<http://www.spektrix.com/factorytheatre/event/132402AMNSPKVCDSTHMBSJPTSBRQSLRMS> a
    schema:Event;
  schema:name "Laura Ramoso & Friends: Live Improv Comedy (Main Space)";
  schema:description """
	Join Laura & Friends for a night of improv with some of Toronto's most decorated comedians! Laura Ramoso is a German Italian comedian best known for her live sketch specials and viral impressions on social media. She has amassed over 3 million followers with her hit characters “German Mom,” “Italian Dad,” and \"Girl who just got back from…\". <span><br/></span><span><br/></span>In 2023, she performed an entirely soldo ut run at the Edinburgh Fringe Festival and London's Soho Theatre with her critically acclaimed second hour, FRANCES. Laura was named a 2023 Just for Laughs New Face of Comedy. In 2024, she embarked on her first international tour with her third special, Sit Up Straight, running 60 sold out shows throughout Australia, New Zealand, Europe, the UK, Canada, and the US. Most recently, she opened for Tina Fey and Amy Poehler on their Restless Leg tour at the Wang Theatre in Boston.
""";
  schema:startDate "2025-07-04T20:00:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/factorytheatre/files/826dbc6f-d0c2-4e7f-ba6a-ee0725cfdc78.jpg>;
  schema:location <https://spektrix.com/factorytheatre/location/1AHGJDSMMPLMPPGNLJBQVLBRSKVDLQRPP>;
  schema:offers _:491c6ecfe2e84a5188c9c36471a83f2f266;
  schema:duration "PT70M";
  schema:endDate "2025-07-04T21:10:00"^^xsd:dateTime .

_:491c6ecfe2e84a5188c9c36471a83f2f266 a schema:AggregateOffer;
  schema:lowPrice "24.0";
  schema:priceCurrency "CAD" .

