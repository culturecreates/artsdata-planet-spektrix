<http://www.spektrix.com/factorytheatre/event/148602ADMSSJSLDJDGPSCSGRCBKSGHQMG> a
    schema:Event;
  schema:name "The Last Glory Hole";
  schema:description """
	<h2>Starring Scott Thompson as Buddy Cole</h2><span><br/></span>Five Shows Only at Factory Theatre<span><br/></span><span><br/></span><span class=\"ItalicText\">“Sometimes being fabulous isn’t enough- and push must come to shove.”</span><span><br/></span><span><br/></span>Scott Thompson is proud to present the world premiere of <span class=\"ItalicText\"><span class=\"BoldText\">The Last Glory Hole</span></span> for five shows only from November 5-8, 2026 at Factory Theatre Mainspace in Toronto. <span class=\"ItalicText\"><span class=\"BoldText\">The Last Glory Hole</span></span> is a new one person show starring Scott as his most famous character and long time alter ego Buddy Cole, a flamboyant gay bar fly renowned for his wit, style, and nose for danger. <span><br/></span><span><br/></span>Written and performed by Scott Thompson, and directed by Alan Kliffer (<span class=\"ItalicText\">Heated Rivalry: The Unauthorized Musical Parody</span>), <span class=\"ItalicText\"><span class=\"BoldText\">The Last Glory Hole</span></span> is a series of all new, hilarious, raunchy, and provocative monologues touching on everything from the state of sensitivity in modern society to Buddy’s globetrotting adventures through the ballrooms, boardrooms, and bedrooms of the planet.<span><br/></span><span><br/></span>Duration: approx. 80 minutes<span><br/></span>Age recommendation: 16+<span><br/></span>CW: Mature Content<span><br/></span><span class=\"BoldText\">Ticket prices include a $2 Heritage Maintenance Fee.</span>
""";
  schema:startDate "2026-11-05T19:30:00"^^xsd:dateTime;
