<http://www.spektrix.com/factorytheatre/event/148002ASGPJPRHPPLSVNVMLVDLLSJQSBR> a
    schema:Event;
  schema:name "Pippin";
  schema:description """
	Step into a world of wonder and self-discovery with <span class=\"ItalicText\"><span class=\"BoldText\">Pippin</span></span>. This musical, from prolific writer <span class=\"BoldText\">Stephen Schwartz</span> <span class=\"ItalicText\">(Wicked, Godspell)</span>, follows the journey of young Pippin as he seeks happiness and fulfillment amidst a troupe of actors who may or may not have his best interests at heart.<span><br/></span><span><br/></span>From award-winning indie theatre company <span class=\"BoldText\">Bowtie Productions</span>, this winner of four 2013 <span class=\"BoldText\">Tony Awards</span>, features unforgettable music, stunning choreography, and themes that resonate across generations. This reimagined production of Pippin invites you to explore the joys and challenges of finding your true purpose – your “corner of the sky.”<span><br/></span><span><br/></span>Duration: 150 minutes including intermission<span><br/></span>Age recommendation: 13+<span><br/></span>Content & sensory warnings: Flashing light, loud music, haze, violence, sexual and mature content.
""";
  schema:startDate "2026-11-15T15:00:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/factorytheatre/files/5fa0a731-bc3c-4823-aade-8f7244ce9cc3.jpg>;
  schema:location <https://spektrix.com/factorytheatre/location/1AHGJDSMMPLMPPGNLJBQVLBRSKVDLQRPP>;
  schema:offers _:1ffe682b6d774e17985871fde78009e7295;
  schema:duration "PT150M";
  schema:endDate "2026-11-15T17:30:00"^^xsd:dateTime .

_:1ffe682b6d774e17985871fde78009e7295 a schema:AggregateOffer;
  schema:lowPrice "50.0";
  schema:priceCurrency "CAD" .

