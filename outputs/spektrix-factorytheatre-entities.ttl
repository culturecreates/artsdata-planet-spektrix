<http://www.spektrix.com/factorytheatre/event/145602AHLQLKLLDMDCNGVCHQDHRBQNJGQ> a
    schema:Event;
  schema:name "Documents Perform 2 | Documentos Actúan 2";
  schema:description """
	<span class=\"ItalicText\"><span class=\"BoldText\">Documents Perform 2 | Documentos Actúan 2</span></span> gives the stage to two projected documents of actual transborder policy -- one in English, one in Spanish. The performance consists of an audience witnessing these documents being taken over by a virtual cast of policymakers and artists to create together, in real time, a cultural policy framework for artistic collaboration and co-production between regions in the Americas. <span><br/></span><span><br/></span>Through writing and rewriting, the online cast will work in concert to address the limitations of current policy, along with the realities of transborder artmaking. How these participants get there, or where they wind up is anyone’s guess.<span><br/></span><span><br/></span>Performance Action | Projections in both Español and English<span><br/></span>Sensory Warning: Fog/haze<span><br/></span>Duration: 75 mins (approx.)<span><br/></span>Age Recommendation: 10+
""";
  schema:startDate "2026-09-25T19:30:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/factorytheatre/files/2d50f06c-27d7-46be-b344-134fe33c6d3a.jpg>;
  schema:location <https://spektrix.com/factorytheatre/location/1AHGJDSMMPLMPPGNLJBQVLBRSKVDLQRPP>;
  schema:offers _:6cfb468278f340539e63131aadaca0c9275;
