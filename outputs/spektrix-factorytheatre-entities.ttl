<http://www.spektrix.com/factorytheatre/event/147002ASLDQKDPKTVNJCLVJMVGTNBNCGP> a
    schema:Event;
  schema:name "Manifiesta";
  schema:description """
	As part of Aluna Theatre’s 25th Anniversary, RUTAS presents <span class=\"ItalicText\">Manifiesta</span>, a gathering to celebrate Latine artists and stories within the Canadian performing arts landscape while looking ahead to the next 25 years. In conversation with Mariló Núñez and Beatriz Pizano, we begin the process of reclaiming our repertoire as we look to the future of Latinx/e theatre in Canada. <span><br/></span><span><br/></span><span><br/></span><a target=\"_blank\" href=\"https://forms.gle/26WRCrstyxyoxGLg6\">Based outside Toronto? Join the live stream link here!</a><span><br/></span><span><br/></span>Duration: approx. 240 minutes <span><br/></span>Age Recommendation: 14+<span><br/></span><span><br/></span>Join us for tamales after our conversatorio!<span><br/></span>
""";
  schema:startDate "2026-09-26T10:00:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/factorytheatre/files/1d0520a1-d465-42c0-8afd-991bf28808d7.jpg>;
