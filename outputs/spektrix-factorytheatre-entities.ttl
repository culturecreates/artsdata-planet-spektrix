<http://www.spektrix.com/factorytheatre/event/147203ALQVDPCHDPLSVNVRGVMHHLVDCCK> a
    schema:Event;
  schema:name "Provisions";
  schema:description """
	<span class=\"BoldText\">A Lester Trips (Theatre) Production in Association with Factory Theatre  | Created by Lauren Gillis & Alaine Hutton</span><span><br/></span><span><br/></span><span class=\"ItalicText\">Have you ever danced on the head of a pin?</span> - the last text sent by the cast and crew of a failed reality tv show set on the moon before they stopped sending footage and went silent.  <span><br/></span> <span><br/></span>On earth, an ordinary broke person in the microgig economy accepts an odd job: accompany an agentic AI to the moon to retrieve the people and data from the failed lunar reality tv venture, and return them to earth before they suffocate. She soon discovers the inhabitants are not easily convinced to leave an erotic choose-your-own virtual reality simulation to board a space megabus back to burning earth. A secret VR love affair, a nun digging a gooneral, and all manner of bodily and metaphysical decomposition confirm suspicions that this gig extends far beyond occasionally assisting a bot with slippery door handles. <span><br/></span><span><br/></span>Duration: approx. 75 minutes<span><br/></span>Age Recommendation: 16+<span><br/></span><span><br/></span><span class=\"ItalicText\">Sensory Warnings: Flashing/strobing lights, loud vocalizations/screaming, loud music, minimal use of unscented vape fluid/minihazer  <span><br/></span><span><br/></span>Content Warnings: Precarious gig work, suffocation, enclosed spaces, profane language, bodily fluids, sexual content, brief depiction of injection, depictions of partial bodily decomposition, partial nudity, behaviour resembling addiction and dissociation, extensive discussions of suicide-adjacent thoughts and behaviours including medical assistant in dying. </span><span><br/></span><span><br/></span><span><br/></span>
""";
  schema:startDate "2026-11-13T19:30:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/factorytheatre/files/cd90cf7b-9f9e-4c7e-bdce-dd63ff604539.jpg>;
  schema:location <https://spektrix.com/factorytheatre/location/1AHGJDSMMPLMPPGNLJBQVLBRSKVDLQRPP>;
  schema:offers _:cc94762c0cc740c68d898da017fa7746309;
  schema:duration "PT75M";
  schema:endDate "2026-11-13T20:45:00"^^xsd:dateTime .

_:cc94762c0cc740c68d898da017fa7746309 a schema:AggregateOffer;
  schema:lowPrice "24.0";
  schema:priceCurrency "CAD" .

<http://www.spektrix.com/factorytheatre/event/147205ACBNJLKTSQBNJLSKKNHDJQVRQJR> a
    schema:Event;
  schema:name "Provisions";
  schema:description """
	<span class=\"BoldText\">A Lester Trips (Theatre) Production in Association with Factory Theatre  | Created by Lauren Gillis & Alaine Hutton</span><span><br/></span><span><br/></span><span class=\"ItalicText\">Have you ever danced on the head of a pin?</span> - the last text sent by the cast and crew of a failed reality tv show set on the moon before they stopped sending footage and went silent.  <span><br/></span> <span><br/></span>On earth, an ordinary broke person in the microgig economy accepts an odd job: accompany an agentic AI to the moon to retrieve the people and data from the failed lunar reality tv venture, and return them to earth before they suffocate. She soon discovers the inhabitants are not easily convinced to leave an erotic choose-your-own virtual reality simulation to board a space megabus back to burning earth. A secret VR love affair, a nun digging a gooneral, and all manner of bodily and metaphysical decomposition confirm suspicions that this gig extends far beyond occasionally assisting a bot with slippery door handles. <span><br/></span><span><br/></span>Duration: approx. 75 minutes<span><br/></span>Age Recommendation: 16+<span><br/></span><span><br/></span><span class=\"ItalicText\">Sensory Warnings: Flashing/strobing lights, loud vocalizations/screaming, loud music, minimal use of unscented vape fluid/minihazer  <span><br/></span><span><br/></span>Content Warnings: Precarious gig work, suffocation, enclosed spaces, profane language, bodily fluids, sexual content, brief depiction of injection, depictions of partial bodily decomposition, partial nudity, behaviour resembling addiction and dissociation, extensive discussions of suicide-adjacent thoughts and behaviours including medical assistant in dying. </span><span><br/></span><span><br/></span><span><br/></span>
""";
  schema:startDate "2026-11-15T14:00:00"^^xsd:dateTime;
