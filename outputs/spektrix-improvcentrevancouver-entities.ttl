<http://www.spektrix.com/improvcentrevancouver/event/75001AGTQCJTJHTKDTVQBGHSKSHJRPGJN>
  a schema:Event;
  schema:name "Ha-Ha Halloween";
  schema:description """
	<h1>Saturday, October 31st - HALLOWEEN</h1><span><br/></span>Join us for a night of ghostly giggles and cackling comedy as our performers stir up frightfully funny scenes from your suggestions. From ghoulish games to devilish tricks and wicked treats, it’s an evening of hilarity that will leave you howling.<span><br/></span><span><br/></span>And don’t forget your costume! Whether you’re a vampire, a zombie, or something too questionable to name, we want to see you in costume! Special prizes will be awarded to the best costume of the night.<span><br/></span><span><br/></span>Creep, crawl, or fly your way to a seat – tickets won’t last!<span><br/></span><span><br/></span>Run time: 90 minutes including intermission.<span><br/></span><span><br/></span>Rated: 🌶️🌶️🌶️ – Includes more references to romantic relationships. May include light fighting or references to violence. There may be references to smoking or drug use. Best for teens and up. (14A)<span><br/></span><span><br/></span>Please Note: as The Improv Centre is a licensed facility, all minors (persons under the age of 19) must be accompanied by an adult.<span><br/></span><span><br/></span>All physical vouchers must now be redeemed via phone or email. Please contact the box office for assistance.
""";
  schema:startDate "2026-10-31T19:00:00"^^xsd:dateTime;
