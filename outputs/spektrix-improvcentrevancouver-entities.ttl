<http://www.spektrix.com/improvcentrevancouver/event/73003ADBCPVQBDQBJSQTLJNGHMRPBKMKS>
  a schema:Event;
  schema:name "Blockbuster";
  schema:description """
	<h1>Select Wednesday & Thursday evenings</h1><span><br/></span>Stop scrolling streamer menus for the perfect movie – we’ll make it up for you on the spot! <span><br/></span><span><br/></span>Become a movie studio executive as improvisers bring movie magic alive on stage. Which movies will get the red carpet treatment and which will be left on the cutting room floor? You decide!<span><br/></span><span><br/></span>Run time: 90 minutes including intermission<span><br/></span><span><br/></span>Rating: 🌶️🌶️ –  Best for audiences age 8 and up.<span><br/></span><span><br/></span>Please Note: as The Improv Centre is a licensed facility, all minors (persons under the age of 19) must be accompanied by an adult.<span><br/></span><span><br/></span>All physical vouchers must now be redeemed via phone or email. Please contact the box office for assistance.
""";
