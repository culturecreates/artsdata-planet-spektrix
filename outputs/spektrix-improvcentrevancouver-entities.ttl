<http://www.spektrix.com/improvcentrevancouver/event/72201AHVJHMKDPLTHSHSHMMBQTMGGKBCN>
  a schema:Event;
  schema:name "Spontaneous Combustion";
  schema:description """
	<h1>Select Tuesday evenings</h1><span><br/></span>Step into our improv laboratory as Mainstage veterans team up with the friendly faces from our House Teams for a night of unpredictable comedy. In the spirit of a Pro-Am comedy show, this experimental blend of seasoned pros and rising stars creates the perfect comedic concoction. <span><br/></span> <span><br/></span>With mixed experience levels and zero safety goggles, expect a hilarious chain reaction of improv scenes where anything can happen. Get ready to witness comedy in its rawest, most reactive form! <span><br/></span><span><br/></span>Tickets are Sliding Scale: $15-$20-$25<span><br/></span><span><br/></span>Run time: 90 minutes including intermission<span><br/></span><span><br/></span>Rated: 🌶️🌶️ – Best for audiences age 8 and up.<span><br/></span><span><br/></span>Please Note: as The Improv Centre is a licensed facility, all minors (persons under the age of 19) must be accompanied by an adult.<span><br/></span><span><br/></span>All physical vouchers must now be redeemed via phone or email. Please contact the box office for assistance.
""";
  schema:startDate "2026-10-06T19:00:00"^^xsd:dateTime;
