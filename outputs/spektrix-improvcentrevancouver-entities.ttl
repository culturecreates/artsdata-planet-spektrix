<http://www.spektrix.com/improvcentrevancouver/event/80801AKDSQPQRGTSQLCDCBHGGGLPQDMLR>
  a schema:Event;
  schema:name "NYE at TIC";
  schema:description """
	<h1>New Year’s Eve Celebration Show</h1><span><br/></span><h2>Ring in 2027 with Laughter!</h2><span><br/></span>What better way to bid 2026 a fond farewell than with laughter? Come join us for an evening full of fun and frivolity as we welcome in the New Year! With scenes based on your best and brightest moments of the past year as well as your excitement and aspirations for 2026, this show is sure to kick the New Year off with laughter and levity!<span><br/></span><span><br/></span><span class=\"BoldText\">What Your Ticket Includes:</span><span><br/></span>1. An amazing show!<span><br/></span>2. Personal Dessert Box<span><br/></span>2. Full access to our Candy Buffet<span><br/></span>4. NYE Photo Wall <span><br/></span><span><br/></span>(GF & VEGAN Desserts & Candy will be available)<span><br/></span><span><br/></span>*Table seats are sold in pairs of 2 only,* each available ticket at a table is for 2 out of 4 seats. If you have any troubles purchasing table seats or have accessibility requirements please email us at boxoffice@theimprovcentre.ca<span><br/></span><span><br/></span><span class=\"BoldText\">Special Event - No Coupons, Subscriptions, Passes, or Vouchers. Drinks not included in ticket price</span><span><br/></span><span><br/></span>7pm & 9pm Show Rated 14A  <span><br/></span><span class=\"UnderlineText\">11pm Show is 19+ only, ID's will be checked at door.</span>
""";
  schema:startDate "2026-12-31T19:00:00"^^xsd:dateTime;
