<http://www.spektrix.com/tidemarktheatre/event/68201ATPHPGBHMDNSHHSTPHBMQBRQBLST>
  a schema:Event;
  schema:name "Alex Cuba";
  schema:description """
	Cuban-born, BC-based artist Alex Cuba has spent more than two decades carving out a musical world of his own, bringing together Latin rhythms, pop, funk and soul.<span><br/></span><span><br/></span>His fiercely independent approach has taken him around the world and earned some of music’s biggest honours, including multiple JUNO Awards, four Latin Grammys and the 2022 Grammy Award for Best Latin Pop Album.<span><br/></span><span><br/></span>At the heart of Alex’s music is a refusal to be boxed in. He follows the song wherever it wants to go, crossing genres and languages without losing the rhythms and musical traditions that have shaped him.<span><br/></span><span><br/></span>On March 12, 2027, experience one of Canada’s most celebrated and distinctive artists, right here in Campbell River.<span><br/></span><span><br/></span>Tickets: $40 Members, $45 Non-Members <span class=\"ItalicText\">(+applicable taxes & fees)</span>
""";
  schema:startDate "2027-03-12T19:30:00"^^xsd:dateTime;
  schema:image <https://system.spektrix.com/tidemarktheatre/files/53769105-33fd-4a5c-9f3d-399277db4015.jpg>;
  schema:location <https://spektrix.com/tidemarktheatre/location/405AGDKDKNLGVLJCSNTLQBVTRTGBTHCPJ>;
  schema:url <https://tidemarktheatre.com/event/alex-cuba/>;
