<http://www.spektrix.com/tidemarktheatre/event/70001AMJRQHDGBRNVCKLMQDNCHKHNLGPL>
  a schema:Event;
  schema:name "Snowed In Comedy Tour";
  schema:description """
	<span class=\"BoldText\">The Snowed In Comedy Tour is back with a brand new show!</span><span><br/></span><span><br/></span>Now celebrating its <span class=\"BoldText\">18th year</span>, what began as a wild idea in the middle of a Canadian winter has snowballed into a national phenomenon and <span class=\"BoldText\">Canada's biggest comedy tour.</span><span><br/></span><span><br/></span>This year's powerhouse lineup features <span class=\"BoldText\">Dan Quinn</span>, Just for Laughs competition winner and tour founder; <span class=\"BoldText\">Paul Myrehaug</span>, winner of the $25,000<span><br/></span>Great Canadian Laugh Off; <span class=\"BoldText\">Pete Zedlacher</span>, SiriusXM Top Comic winner and 6-time Canadian Comedy Award nominee; and <span class=\"BoldText\">Erica Sigurdson</span>, one of CBC's The Debaters most popular performers with more than 80 appearances.<span><br/></span><span><br/></span><span class=\"BoldText\">Four international comedians. One stage. Eighteen years of laughs.</span><span><br/></span><span><br/></span>Critics call it “Better than the Just for Laughs Tour” and “A Flurry of Laughs You Can't Miss.”<span><br/></span><span><br/></span><span class=\"BoldText\">Don't just get through winter - laugh your way through it with the Snowed In Comedy Tour.</span><span><br/></span><span><br/></span>Tickets: $58.00 Admission, $48.00 Senior 65+ <span class=\"ItalicText\">(+applicable taxes & fees)</span>
""";
  schema:startDate "2027-01-20T19:30:00"^^xsd:dateTime;
