<http://www.spektrix.com/tidemarktheatre/event/63801ASLGTSVCPMCNVRGGPRNTHGJSNJGL>
  a schema:Event;
  schema:name "Barracuda & All Fired Up";
  schema:description """
	<h2>“Tributes to Heart & Pat Benatar”</h2><span><br/></span>Heart & Pat Benatar have sold over 70 million albums combined and have been performing for over 4 decades. Barracuda & All Fired Up replicate the vocals & music to perfection and have been selling out shows throughout North America.<span><br/></span><span><br/></span><span class=\"BoldText\">Barracuda</span><span><br/></span><span class=\"ItalicText\">Barracuda</span>, <span class=\"ItalicText\">Magic Man</span>, <span class=\"ItalicText\">Crazy on You</span>, <span class=\"ItalicText\">These Dreams</span>, <span class=\"ItalicText\">All I Wanna Do</span>, <span class=\"ItalicText\">Straight On</span>, <span class=\"ItalicText\">Heartless,</span> and many more, along with performing some classic Led Zeppelin tunes like <span class=\"ItalicText\">Stairway to Heaven</span>, <span class=\"ItalicText\">Black Dog</span>, <span class=\"ItalicText\">Kashmir</span>, and <span class=\"ItalicText\">Battle of Evermore,</span> as Heart still do to this day.<span><br/></span><span><br/></span><span class=\"BoldText\">All Fired Up</span><span><br/></span><span class=\"ItalicText\">Hit Me With Your Best Shot</span>, <span class=\"ItalicText\">Heartbreaker</span>, <span class=\"ItalicText\">Love is a Battlefield</span>, <span class=\"ItalicText\">We Belong</span>, <span class=\"ItalicText\">Promises in the Dark</span>, <span class=\"ItalicText\">Shadows of the Night</span> & more!<span><br/></span><span><br/></span>Tickets: $49.50 Admission, $45.50 Groups 6+ <span class=\"ItalicText\">(includes GST, +additional fees)</span>
""";
  schema:startDate "2026-10-23T19:30:00"^^xsd:dateTime;
