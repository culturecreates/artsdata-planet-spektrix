  a schema:Event;
  schema:name "Volume One/Operators NYE";
  schema:description """
	<table class=\" BorderOn\">
		<tr>
			<td align=\"left\" colspan=\"1\"><img /> </td><td align=\"left\"><h2>Volume One/Operators present </h2><h1><span class=\"UnderlineText\">VOLUME ONE/OPERATORS NYE</span></h1></td>
		</tr>
	</table><span><br/></span><span class=\"ItalicText\"><span class=\"BoldText\">This event is for ages 19+</span></span><span><br/></span><span><br/></span>Outside, the year is ending. Inside, we're just getting started.<span><br/></span><span><br/></span>VolumeOne and Operators take over the Black Box for a New Year's Eve built around deep grooves, dark corners, and the pull of the dance floor. House and techno from five artists, each bringing their own take on the night.<span><br/></span><span><br/></span>LAW · Sheebz · Downshift · Eric Allen · Angie C<span><br/></span><span><br/></span>No resolutions required. Come as you are. Leave in a different year.<span><br/></span><span><br/></span>---<span><br/></span><span><br/></span><h2>Pricing</h2><span><br/></span><span><br/></span><span class=\"ItalicText\">All above prices are in CAD and include GST.</span><span><br/></span><span><br/></span>---<span><br/></span><span><br/></span><span class=\"ItalicText\">A service fee is added for box office costs, card processing, and taxes. <span class=\"BoldText\">Volume One/Operators NYE</span> tickets and service fees are non-refundable.</span>
""";
