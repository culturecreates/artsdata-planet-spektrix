<http://www.spektrix.com/kelownacommunitytheatre/event/407201ARCSTSVJRNHKQDHDRPHQNVMTKJG>
  a schema:Event;
  schema:name "Reel Okanagan - Haida Modern";
  schema:description """
	<table class=\" BorderOn\">
		<tr>
			<td align=\"left\" colspan=\"1\"><img src=\"https://system.spektrix.com/kelownacommunitytheatre/files/323c1a27-9c50-4489-9aed-3d2731cff776.jpg\" /> </td><td align=\"left\"><h2>Reel Okanagan Film Festival presents </h2><h1><span class=\"UnderlineText\">HAIDA MODERN</span></h1></td>
		</tr>
	</table><span><br/></span><span><br/></span>A documentary exploring the life, art, and activism of renowned Haida artist Robert Davidson. The film examines Indigenous culture, identity, and artistic expression while highlighting themes of reconciliation and cultural preservation.<span><br/></span><span><br/></span>---<span><br/></span><span><br/></span><h2>Pricing</h2><span><br/></span><span class=\"BoldText\">Regular  $16.51</span>  ($12.00 base price + $2.36 CIF + $2.15 service charge)<span><br/></span><span><br/></span><span class=\"ItalicText\">All above prices include GST</span><span><br/></span><span><br/></span>---<span><br/></span><span><br/></span><span class=\"ItalicText\">Mary Irwin Theatre at the Rotary Centre for the Arts event tickets include a $2.36 Capital Improvement Fee (CIF). A service fee is added for box office costs, card processing, and taxes. <span class=\"BoldText\">Haida Modern</span> tickets and their applicable fees are non-refundable.</span>
""";
