<http://www.spektrix.com/kelownacommunitytheatre/event/410201ALTJGLBTSCBPRNLVQLRSLNLKDPV>
  a schema:Event;
  schema:name "God Is A Scottish Drag Queen Halloween Spooktacular";
  schema:description """
	<table class=\" BorderOn\">
		<tr>
			<td align=\"left\" colspan=\"1\"><img src=\"https://system.spektrix.com/kelownacommunitytheatre/files/9036cc2e-d88c-4226-bc72-6ac3142a01a9.jpg\" /> </td><td align=\"left\"><h2>Mike & Chantelle Delamont present </h2><h1><span class=\"UnderlineText\">GOD IS A SCOTTISH DRAG QUEEN HALLOWEEN SPOOKTACULAR</span></h1></td>
		</tr>
	</table><span><br/></span>★★★★★ \"A Hilarious & Heavenly Way To Spend An Evening!\" CBC<span><br/></span><span><br/></span>★★★★★ \"A Cross Between Dame Edna & Billy Connolly With A Dollop Of Eddie Izzard!\" National Post<span><br/></span><span><br/></span>★★★★★ \"God Is Great!\" London Free Press<span><br/></span><span><br/></span>The beloved deity in a floral power suit returns with a spook-tacular twist! God descends from the heavens (or perhaps a haunted attic?) to hilariously roast everything from pumpkin spice lattes to demonic possession in a laugh-out-loud night of comedy. Expect divine commentary on the bizarre traditions of Halloween, terrifying costume choices, and the true horror of candy corn. A seasonal special packed with sass, satire, and supernatural wit—because nothing is scarier than eternal damnation…except maybe Spirit Halloween.<span><br/></span><span><br/></span>---<span><br/></span><span><br/></span><h2>Pricing</h2><span><br/></span><span class=\"BoldText\">Regular  $54.11</span>  ($45.00 base price + $2.36 CIF + $6.75 service charge)<span><br/></span><span><br/></span><span class=\"ItalicText\">All above prices are in CAD and include GST.</span><span><br/></span><span><br/></span>---<span><br/></span><span><br/></span><span class=\"ItalicText\">Kelowna Community Theatre event tickets include a $2.36 Capital Improvement Fee (CIF). A service fee is added for box office costs, card processing, and taxes. Tickets for <span class=\"BoldText\">God is a Scottish Drag Queen Halloween Spooktacular</span> and their applicable service fees are non-refundable.</span>
""";
  schema:startDate "2026-10-28T19:30:00"^^xsd:dateTime;
