  a schema:Event;
  schema:name "Humans In Motion";
  schema:description """
	<table class=\" BorderOn\">
		<tr>
			<td align=\"left\" colspan=\"1\"><img src=\"https://system.spektrix.com/kelownacommunitytheatre/files/76f7b35c-cebb-4442-83af-cde725278a0a.jpg\" /> </td><td align=\"left\"><h2>Bachelor of Media Studies Course Union presents </h2><h1><span class=\"UnderlineText\">HUMANS IN MOTION</span></h1></td>
		</tr>
	</table><span><br/></span><span class=\"BoldText\">For Mature Audiences</span><span><br/></span><span><br/></span><span class=\"ItalicText\">Humans in Motion</span> is an annual selection of international short live-action films curated by local artist and professor, Myron Campbell. Drawn from Canada and the U.S., these films celebrate a wide range of storytelling spanning genres and challenging convention. <span class=\"ItalicText\">Humans in Motion</span> is always surprising, always affecting, and always proof that a camera and a vision are enough to take you somewhere you never expected to go. Each year, the program raises funds for a new community initiative, this year supporting the Bachelor of Media Studies Course Union at UBC Okanagan.<span><br/></span><span><br/></span>---<span><br/></span><span><br/></span><h2>Pricing</h2><span><br/></span><span class=\"BoldText\">VIP (premium seating)  $48.71</span>  ($40.00 base price + $2.36 CIF + $6.35 service charge)<span><br/></span><span><br/></span><span class=\"BoldText\">Regular  $31.46</span>  ($25.00 base price + $2.36 CIF + $4.10 service charge)<span><br/></span><span class=\"BoldText\">Student  $17.49</span>  ($12.50 base price + $2.36 CIF + $2.63 service charge)<span><br/></span><span><br/></span><span class=\"ItalicText\">All above prices include GST</span><span><br/></span><span><br/></span>---<span><br/></span><span><br/></span><span class=\"ItalicText\">Mary Irwin Theatre at the Rotary Centre for the Arts event tickets include a $2.36 Capital Improvement Fee (CIF). A service fee is added for box office costs, card processing, and taxes. <span class=\"BoldText\">Humans in Motion</span> tickets and their applicable fees are non-refundable.</span>
""";
