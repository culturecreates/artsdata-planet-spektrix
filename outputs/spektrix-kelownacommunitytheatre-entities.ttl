<http://www.spektrix.com/kelownacommunitytheatre/event/405401AHQCSBVMPJVRJRCPMNCTKGTLJDD>
  a schema:Event;
  schema:name "Ballet Kelowna - A Streetcar Named Desire";
  schema:description """
	<table class=\" BorderOn\">
		<tr>
			<td align=\"left\" colspan=\"1\"><img src=\"https://system.spektrix.com/kelownacommunitytheatre/files/a206573c-6230-4904-a884-22b2f6f3f249.jpg\" /> </td><td align=\"left\"><h2>Ballet Kelowna presents </h2><h1><span class=\"UnderlineText\">A STREETCAR NAMED DESIRE</span></h1><h2><span class=\"BoldText\">February 12 + 13, 2027</span></h2><span class=\"BoldText\">Friday at 7:30 PM / Saturday at 1:30 PM and 7:30 PM</span></td>
		</tr>
	</table><span><br/></span><span class=\"BoldText\"><a target=\"_blank\" href=\"https://www.theboxoffice.ca/ballet-kelowna-202627\">Ballet Kelowna 2026/27 subscriptions on sale now through November 7th.</a></span><span><br/></span><span><br/></span> ---<span><br/></span><span><br/></span><h2>A full-length ballet adapted from Tennessee Williams’ prize-winning drama</h2><span><br/></span><span class=\"BoldText\">Choreography:</span> John Alleyne<span><br/></span><span class=\"BoldText\">Composer:</span> Tobin Stokes<span><br/></span><span><br/></span>John Alleyne, one of Canada's most renowned choreographers, draws on the complexities of Tennessee Williams' 1947 Pulitzer Prize-winning drama <span class=\"ItalicText\">A Streetcar Named Desire</span> in a full-length narrative ballet originally created for Ballet BC. Weaving between past and present, this evocative adaptation tells the story of two sisters – one clinging to a bygone era while the other embraces the realities of contemporary life in America. Set against the backdrop of post-World War II New Orleans, Alleyne explores themes of fragility and vitality, deftly juxtaposing the decline of the old aristocracy with the rise of the working class. Featuring an original jazz score by BC-based composer Tobin Stokes, lavish costumes, and captivating theatrical performances, Alleyne's <span class=\"ItalicText\">A Streetcar Named Desire</span> is a riveting portrait of passion, power, and social tension that <span class=\"ItalicText\">The Globe and Mail</span> hailed as \"an impressive achievement.\"<span><br/></span><span><br/></span>Ballet Kelowna’s 2026/27 season is presented by the Thomas Alan Budd Foundation.<span><br/></span><span><br/></span> ---<span><br/></span><span><br/></span><h2>Pricing</h2><span><br/></span><span class=\"UnderlineText\">Section A</span> <span><br/></span><span class=\"BoldText\">Adult</span> $87.21 base price + $2.36 CIF + $13.08 service charge = <span class=\"BoldText\">$102.65</span> <span><br/></span><span class=\"BoldText\">Senior</span> $77.73 base price + $2.36 CIF + $11.66 service charge = <span class=\"BoldText\">$91.75</span> <span><br/></span><span class=\"BoldText\">Student/Child</span> $33.44 base price + $2.36 CIF + $5.02 service charge = <span class=\"BoldText\">$40.81</span> <span><br/></span> <span><br/></span><span class=\"UnderlineText\">Section B</span> <span><br/></span><span class=\"BoldText\">Adult</span> $74.90 base price + $2.36 CIF + $11.23 service charge = <span class=\"BoldText\">$88.49</span> <span><br/></span><span class=\"BoldText\">Senior</span> $66.42 base price + $2.36 CIF + $9.96 service charge = <span class=\"BoldText\">$78.75</span> <span><br/></span><span class=\"BoldText\">Student/Child</span> $33.44 base price + $2.36 CIF + $5.02 service charge = <span class=\"BoldText\">$40.81</span> <span><br/></span> <span><br/></span><span class=\"UnderlineText\">Section C</span> <span><br/></span><span class=\"BoldText\">Adult</span> $63.98 base price + $2.36 CIF + $9.60 service charge = <span class=\"BoldText\">$75.94</span> <span><br/></span><span class=\"BoldText\">Senior</span> $55.49 base price + $2.36 CIF + $8.32 service charge = <span class=\"BoldText\">$66.17</span> <span><br/></span><span class=\"BoldText\">Student/Child</span> $33.44 base price + $2.36 CIF + $5.02 service charge = <span class=\"BoldText\">$40.81</span> <span><br/></span><span class=\"BoldText\">Accessible seating/Companion</span> $33.44 base price + $2.36 CIF + $5.02 service charge = <span class=\"BoldText\">$40.81</span> <span><br/></span><span><br/></span><span class=\"ItalicText\">A service fee is added for box office costs, card processing, and taxes. <span class=\"BoldText\">Ballet Kelowna</span> tickets and their applicable fees are non-refundable.</span>
""";
