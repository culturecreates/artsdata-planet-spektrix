<http://www.spektrix.com/kelownacommunitytheatre/event/394001AKJRSLSPJGTRQDVKHJQRTRQVNDD>
  a schema:Event;
  schema:name "Punjabi Virsa";
  schema:description """
	<table class=\" BorderOn\">
		<tr>
			<td align=\"left\" colspan=\"1\"><img src=\"https://system.spektrix.com/kelownacommunitytheatre/files/e8004968-f214-4029-b6f1-f26ef7511d5b.jpg\" /> </td><td align=\"left\"><h2>Pita Pit presents </h2><h1><span class=\"UnderlineText\">PUNJABI VIRSA</span></h1></td>
		</tr>
	</table><span><br/></span><h2><span class=\"BoldText\">IMPORTANT UPDATE!</span></h2><span class=\"ItalicText\">Due to unforeseen circumstances, Punjabi Virsa has been <span class=\"UnderlineText\"><span class=\"BoldText\">rescheduled</span></span> from Sunday, August 16th, 2026 to <span class=\"BoldText\">Sunday October 11th, 2026.</span></span> Ticketholders have been notified via email. We look forward to welcoming you on the new date!<span><br/></span><span><br/></span>---<span><br/></span><span><br/></span>Punjabi Virsa is a vibrant celebration of Punjabi culture, music, and community, bringing together live performances, high-energy dance, and an unforgettable atmosphere. Experience the rhythms, traditions, and spirit of Punjab right here in Kelowna. Proudly presented by Pita Pit & Happy Slice, this exciting event showcases talented artists and delivers a lively night filled with music, connection, and cultural pride. Don’t miss your chance to be part of this dynamic and entertaining experience.<span><br/></span><span><br/></span><span><br/></span><h2>Pricing</h2><span><br/></span><span class=\"BoldText\">VIP 1  $289.86</span>  ($250.00 base price + $2.36 CIF + $37.50 service charge)<span><br/></span><span class=\"BoldText\">VIP 2  $232.36</span>  ($200.00 base price + $2.36 CIF + $30.00 service charge)<span><br/></span><span class=\"BoldText\">VIP 3  $174.86</span>  ($150.00 base price + $2.36 CIF + $22.50 service charge)<span><br/></span><span><br/></span><span class=\"BoldText\">Tier 1  $117.36</span>  ($100.00 base price + $2.36 CIF + $15.00 service charge)<span><br/></span><span class=\"BoldText\">Tier 2  $94.36</span>  ($80.00 base price + $2.36 CIF + $12.00 service charge)<span><br/></span><span class=\"BoldText\">Tier 3  $71.36</span>  ($60.00 base price + $2.36 CIF + $9.00 service charge)<span><br/></span><span class=\"BoldText\">Tier 4  $59.86</span>  ($50.00 base price + $2.36 CIF + $7.50 service charge)<span><br/></span><span><br/></span><span class=\"ItalicText\">All above prices are in CAD and include GST.</span><span><br/></span><span><br/></span>---<span><br/></span><span><br/></span><span class=\"ItalicText\">Kelowna Community Theatre event tickets include a $2.36 Capital Improvement Fee (CIF). A service fee is added for box office costs, card processing, and taxes. <span class=\"BoldText\">Punjabi Virsa</span> tickets and their applicable service fees are non-refundable.</span>
""";
