<http://www.spektrix.com/kelownacommunitytheatre/event/395001AGNQLSTKTCJKGHPGCSCSKPVKGRN>
  a schema:Event;
  schema:name "Mountains On Stage Winter Edition 2026";
  schema:description """
	<table class=\" BorderOn\">
		<tr>
			<td align=\"left\" colspan=\"1\"><img src=\"https://system.spektrix.com/kelownacommunitytheatre/files/1a31200f-178d-43d5-a52a-55ddada01cca.jpg\" /> </td><td align=\"left\"><h2>High Events presents </h2><h1><span class=\"UnderlineText\">MOUNTAINS ON STAGE</span></h1><h2><span class=\"ItalicText\"><span class=\"BoldText\">Winter Edition 2026</span></span></h2></td>
		</tr>
	</table><span><br/></span><span><br/></span>Mountains on Stage is an international mountain film festival showcasing a selection of the best adventure, climbing, skiing, mountaineering, and outdoor films. Through inspiring stories and stunning cinematography, it brings mountain and outdoor enthusiasts together around the world.<span><br/></span><span><br/></span>The 2026 Winter Film selection will be announced soon! Check here for more details: <a target=\"_blank\" href=\"https://www.mountainsonstage.com/filmselection\">https://www.mountainsonstage.com/filmselection</a><span><br/></span><span><br/></span><h2>Pricing</h2><span><br/></span><span class=\"BoldText\">Adult  $28.00</span>  ($21.99 base price + $2.36 CIF + $3.65 service charge)<span><br/></span><span class=\"BoldText\">Student w/ID  $23.00</span>  ($17.64 base price + $2.36 CIF + $3.00 service charge)<span><br/></span><span class=\"BoldText\">Senior  $23.00</span>  ($17.64 base price + $2.36 CIF + $3.00 service charge)<span><br/></span><span><br/></span><span class=\"ItalicText\">All above prices are CAD and include GST.</span><span><br/></span><span><br/></span>---<span><br/></span><span><br/></span><span class=\"ItalicText\">Mary Irwin Theatre at the Rotary Centre for the Arts event tickets include a $2.36 Capital Improvement Fee (CIF). A service fee is added for box office costs, card processing, and taxes. <span class=\"BoldText\">Mountains on Stage</span> ticket fees are non-refundable.</span>
""";
