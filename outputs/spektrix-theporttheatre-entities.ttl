<http://www.spektrix.com/theporttheatre/event/92803AMTCGLPLGGMGKHJCNMPMNKJQPKTT> a
    schema:Event;
  schema:name "SuperLiminal: The Game Show!";
  schema:description """
	Ask For Improv presents: SuperLiminal: The Game Show!<span><br/></span>This is the improv game show you’ve been waiting for! Fueled by your suggestions, our fearless performers will dive into fast-paced, short-form scenes packed with surprises, silliness, and plenty of laughs. No script, no safety net—just pure improv magic created right before your eyes!  <span><br/></span><span><br/></span><span class=\"BoldText\">Encore Tickets $26.50</span> - Throw a little extra love to a Fringe Artist. It's like tipping your favorite server, but with way more glitter and a lot less drama! Our Fringe Artist wallets thank you.<span><br/></span><span><br/></span>All patrons are required to purchase a <span class=\"BoldText\">$5.00 FRINGE FESTIVAL BUTTON</span> to see any shows. Proceeds support the operating costs of the Nanaimo Fringe Festival. (If you lose or forget your button you will need to purchase another)
""";
  schema:startDate "2026-08-08T17:00:00"^^xsd:dateTime;
