<http://www.spektrix.com/theporttheatre/event/95601AKBTMBPSVSQQNHNMNCNJRTLHSSTL> a
    schema:Event;
  schema:name "FIREWORKS: A Celebration of the Tragically Hip";
  schema:description """
	Got Pop? Concerts presents FIREWORKS: A Celebration of the Music of The Tragically Hip<span><br/></span> <span><br/></span>Featuring:<span><br/></span>RYAN MCMAHON<span><br/></span>JOEL LEE<span><br/></span>KEVIN'S BACON<span><br/></span>SHEL<span><br/></span>MYLES YOUNG & SEAN O'BRIEN<span><br/></span>DAVID BITONTI<span><br/></span> <span><br/></span>Partial proceeds to be donated to the Sonnybrook Foundation for brain cancer research.<span><br/></span> <span><br/></span>This is our third year in a row celebrating the music of one of Canada's most beloved bands - THE TRAGICALLY HIP! We have an amazing lineup of talent performing your favourite Hip classics and rarities. We have raised over $3000 from our previous two events that went to brain cancer research. Help us continue to support this great cause and also enjoy some incredible music too! <span><br/></span><span><br/></span><a target=\"_blank\" href=\"http://gotpopconcerts.com\"> gotpopconcerts.com</a><span><br/></span>
""";
