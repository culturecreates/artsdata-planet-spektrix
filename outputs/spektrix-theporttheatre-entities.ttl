<http://www.spektrix.com/theporttheatre/event/96801ADHLKNLHKQQPHHDBRLVLVNSHTGBL> a
    schema:Event;
  schema:name "It's A Wonderful Wunderbread Christmas";
  schema:description """
	Please join us for Wunderbread's 30th Year Anniversary Christmas Show. Witness The West Coast's finest live disco-funk extravaganza. Founding members Tina Jones and Pierre Komen will get down with your favorite 70's Hits. Horn section and all. <span><br/></span><span><br/></span>Featured guests Taylor Knight and Lee Worden will be performing specially selected Christmas Classics. Throw in a few surprise appearances and this 8 piece ensemble will show you what years of playing together feels and sounds like. Our Wunderbread Stage Dancers will also be there to keep you tappin'. <span><br/></span><span><br/></span>Let us leave our hearts on stage and show our appreciation for supporting Wunderbread for over 30 years. Thank You and we will see you there!
""";
  schema:startDate "2026-12-11T19:30:00"^^xsd:dateTime;
